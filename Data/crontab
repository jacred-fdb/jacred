# JacRed host crontab — edit by hand (source of truth).
# Install: crontab /opt/jacred/Data/crontab
# Runner:  /opt/jacred/Data/run-job.sh <name> <url> <max_time>
#   flock (no curl pile-up) + curl --max-time
# Default base: http://127.0.0.1:9117 — change host/port if needed.
# If apikey/devkey is set, append ?apikey=... or ?devkey=... to each URL.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# jsondb-save -> /jsondb/save (max_time=60s)
# every 5 min (e.g. :00,:05,:10,…)
*/5 * * * *  /opt/jacred/Data/run-job.sh jsondb-save http://127.0.0.1:9117/jsondb/save 60

# cloudflare-warmup keep-alive -> /cron/cloudflare/Warmup (max_time=300s)
# every 20 min — keeps FlareSolverr session `jacred` warm (cf_clearance in browser)
5,25,45 * * * *  /opt/jacred/Data/run-job.sh cloudflare-keepalive http://127.0.0.1:9117/cron/cloudflare/Warmup 300

# cloudflare-warmup -> /cron/cloudflare/Warmup (max_time=300s)
# every hour at :55 — warm FlareSolverr session before rutracker-parse at :00
55 * * * *  /opt/jacred/Data/run-job.sh cloudflare-warmup http://127.0.0.1:9117/cron/cloudflare/Warmup 300

# maintenance-check -> /cron/maintenance/Check?mode=report (max_time=60s)
# Sunday 05:00
0 5 * * 0  /opt/jacred/Data/run-job.sh maintenance-check http://127.0.0.1:9117/cron/maintenance/Check?mode=report 60

# --- rutracker (~1.5M) ---
# rutracker-parse -> /cron/rutracker/parse (max_time=3600s)
# every hour at :00 (after cloudflare-warmup :55)
0 * * * *  /opt/jacred/Data/run-job.sh rutracker-parse http://127.0.0.1:9117/cron/rutracker/parse 3600

# rutracker-UpdateTasksParse -> /cron/rutracker/UpdateTasksParse (max_time=60s)
